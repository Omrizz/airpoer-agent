# Copy this file to .env and fill in your key. .env is gitignored; never commit it.
ANTHROPIC_API_KEY=
# Optional overrides. Default model is claude-sonnet-5-5 (see docs/MODEL_CHOICE.md).
# ANTHROPIC_MODEL=claude-opus-5-5     # most thorough, about 2x the cost
# ANTHROPIC_EFFORT=medium             # low | medium | high
# ANTHROPIC_FALLBACKS=off             # disable the server-side refusal fallback (required for Haiku 5.5)
