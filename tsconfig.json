{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true, "allowJs": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "scripts", "tests"]
}

